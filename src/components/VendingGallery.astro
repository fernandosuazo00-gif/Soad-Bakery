---
import { Image } from "astro:assets";
import SectionHeading from "./SectionHeading.astro";
import { vendingItems } from "../data/vending";
---

<section class="bg-cream-100 py-16 md:py-24">
  <div class="container-page">
    <SectionHeading
      kicker="En la vending"
      title="Lo que encontrás en la vending machine"
      subtitle="Fotos reales de productos disponibles a través de nuestra vending machine en Centro Cívico Gubernamental. El catálogo oficial y la disponibilidad los confirmamos por WhatsApp."
    />

    <ul class="mt-10 grid grid-cols-2 gap-3 sm:gap-5 md:grid-cols-3 lg:grid-cols-4">
      {
        vendingItems.map((item) => (
          <li class="group overflow-hidden rounded-[var(--radius-card)] bg-white shadow-[var(--shadow-soft)]">
            <div class="aspect-[4/5] overflow-hidden bg-cream-200">
              <Image
                src={item.image}
                alt={item.alt}
                width={480}
                height={600}
                widths={[320, 480, 640]}
                sizes="(min-width: 1024px) 296px, (min-width: 768px) 30vw, 46vw"
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
            </div>
            <p class="px-4 py-3.5 font-display text-sm font-semibold leading-snug text-ink-950 sm:text-base">
              {item.name}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
