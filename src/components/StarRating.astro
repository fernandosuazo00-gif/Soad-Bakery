---
interface Props {
  rating: number;
  class?: string;
}

const { rating, class: className = "" } = Astro.props;
const stars = [1, 2, 3, 4, 5];
---

<div class:list={["flex items-center gap-0.5", className]} role="img" aria-label={`${rating} de 5 estrellas`}>
  {
    stars.map((n) => (
      <svg viewBox="0 0 20 20" class="h-4 w-4" aria-hidden="true">
        <path
          d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6L10 1.5Z"
          fill={n <= Math.round(rating) ? "currentColor" : "none"}
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linejoin="round"
        />
      </svg>
    ))
  }
</div>
