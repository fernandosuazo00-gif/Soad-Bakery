---
import { social } from "../data/site";

interface Props {
  class?: string;
  iconClass?: string;
}

const { class: className = "", iconClass = "h-5 w-5" } = Astro.props;

const links = [
  { name: "Instagram", href: social.instagram },
  { name: "TikTok", href: social.tiktok },
  { name: "Facebook", href: social.facebook },
];
---

<div class:list={["flex items-center gap-3", className]}>
  {
    links.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`SOAD Bakery en ${link.name}`}
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-current/20 transition-colors hover:border-current/40 hover:bg-current/5 cursor-pointer"
      >
        {link.name === "Instagram" && (
          <svg viewBox="0 0 24 24" fill="none" class={iconClass} aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6" />
            <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6" />
            <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" />
          </svg>
        )}
        {link.name === "TikTok" && (
          <svg viewBox="0 0 24 24" fill="currentColor" class={iconClass} aria-hidden="true">
            <path d="M14.5 3h2.2c.2 1.6 1.2 3 2.6 3.7v2.3a5.9 5.9 0 0 1-2.6-.6v6.2a5.6 5.6 0 1 1-5.6-5.6c.2 0 .4 0 .6.03v2.3a3.3 3.3 0 1 0 2.4 3.2V3Z" />
          </svg>
        )}
        {link.name === "Facebook" && (
          <svg viewBox="0 0 24 24" fill="currentColor" class={iconClass} aria-hidden="true">
            <path d="M13.5 21v-7.2h2.4l.4-2.8h-2.8V9.2c0-.8.2-1.4 1.4-1.4h1.5V5.3c-.3 0-1.1-.1-2.1-.1-2.1 0-3.5 1.3-3.5 3.6v2.2H8.4v2.8h2.4V21h2.7Z" />
          </svg>
        )}
      </a>
    ))
  }
</div>
