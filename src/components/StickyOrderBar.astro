<div
  id="sticky-order-bar"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-ink-950/10 bg-cream-50/95 px-4 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-3 backdrop-blur md:hidden"
>
  <div id="sticky-bar-empty" class="flex items-center gap-3">
    <a href="/productos" class="btn btn-primary w-full">Ordenar ahora</a>
  </div>

  <div id="sticky-bar-filled" class="hidden items-center justify-between gap-3">
    <div class="min-w-0">
      <p class="text-xs font-semibold text-stone-500">
        <span id="sticky-bar-count">0</span> artículo(s)
      </p>
      <p id="sticky-bar-subtotal" class="truncate text-base font-bold tabular-nums text-ink-950">L 0</p>
    </div>
    <button type="button" id="sticky-bar-cta" class="btn btn-primary shrink-0">Ver pedido</button>
  </div>
</div>

<script>
  import { SoadCart } from "../scripts/cart";
  import { formatLempiras } from "../lib/currency";

  const empty = document.getElementById("sticky-bar-empty")!;
  const filled = document.getElementById("sticky-bar-filled")!;
  const countEl = document.getElementById("sticky-bar-count")!;
  const subtotalEl = document.getElementById("sticky-bar-subtotal")!;
  const cta = document.getElementById("sticky-bar-cta")!;

  cta.addEventListener("click", () => {
    window.dispatchEvent(new CustomEvent("soad-cart:open"));
  });

  const applyState = (count: number, subtotal: number, hasUnpricedItems: boolean) => {
    const hasItems = count > 0;
    empty.classList.toggle("hidden", hasItems);
    empty.classList.toggle("flex", !hasItems);
    filled.classList.toggle("hidden", !hasItems);
    filled.classList.toggle("flex", hasItems);
    countEl.textContent = String(count);
    subtotalEl.textContent = formatLempiras(subtotal) + (hasUnpricedItems ? " +" : "");
  };

  window.addEventListener("soad-cart:change", (e) => {
    const { count, subtotal, hasUnpricedItems } = (e as CustomEvent).detail;
    applyState(count, subtotal, hasUnpricedItems);
  });

  // Imported (not just the global) so this module is guaranteed evaluated
  // and the cart is readable synchronously — avoids a race with the
  // page-wide init broadcast firing before this listener is registered.
  const initialItems = SoadCart.getItems();
  applyState(
    initialItems.reduce((sum, i) => sum + i.qty, 0),
    initialItems.reduce((sum, i) => sum + (i.price ?? 0) * i.qty, 0),
    initialItems.some((i) => i.price === null)
  );
</script>
