---
import { Image } from "astro:assets";
import teamPhoto from "../assets/history/soad-faraj-team.jpg";
import SectionHeading from "./SectionHeading.astro";
---

<section class="py-16 md:py-24">
  <div class="container-page grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <div class="relative">
      <Image
        src={teamPhoto}
        alt="Soad Faraj, fundadora de SOAD Bakery, junto a su equipo en la cocina"
        width={900}
        height={1125}
        class="aspect-[4/5] w-full rounded-[var(--radius-card)] object-cover object-top shadow-[var(--shadow-soft)]"
        loading="lazy"
      />
    </div>

    <div>
      <SectionHeading
        kicker="Nuestra Historia"
        title="Soad Bakery nació de un nuevo comienzo"
        subtitle="En medio de una etapa difícil, Soad Faraj encontró en la repostería un espacio para crear, soñar y volver a creer en sí misma. Hoy, cada creación lleva un pedacito de esa historia."
      />
      <a href="/nuestra-historia" class="btn btn-ghost-dark mt-6">Conocer la historia completa</a>
    </div>
  </div>
</section>
