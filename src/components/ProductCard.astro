---
import { Image } from "astro:assets";
import type { Product } from "../data/products";
import { formatLempiras } from "../lib/currency";

interface Props {
  product: Product;
  imageWidths?: number[];
  loading?: "lazy" | "eager";
}

const { product, loading = "lazy" } = Astro.props;

// The cart only needs a lightweight JSON payload — build it once and
// resolve the built image src for the cart thumbnail.
const cardPayload = JSON.stringify({
  id: product.id,
  name: product.name,
  price: product.price,
  image: product.image.src,
});
---

<article
  data-product-card
  data-category={product.category}
  class="group flex flex-col overflow-hidden rounded-[var(--radius-card)] bg-white shadow-[var(--shadow-soft)] transition-transform duration-200"
>
  <div class="relative aspect-[4/5] overflow-hidden bg-cream-200">
    <Image
      src={product.image}
      alt={product.alt}
      width={480}
      height={600}
      loading={loading}
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  </div>

  <div class="flex flex-1 flex-col gap-2 p-4">
    <h3 class="font-display text-base font-semibold leading-snug text-ink-950">
      {product.name}
    </h3>
    <p class="line-clamp-2 text-sm text-stone-600">{product.description}</p>

    <div class="mt-auto flex items-center gap-2 pt-3">
      {
        product.price !== null && (
          <span class="text-lg font-bold tabular-nums text-ink-950">
            {formatLempiras(product.price)}
          </span>
        )
      }

      <div class="ml-auto flex items-center gap-1 rounded-full border border-ink-950/15 px-0.5">
        <button
          type="button"
          class="qty-decrement flex h-8 w-8 items-center justify-center text-base font-bold text-ink-950 cursor-pointer"
          aria-label={`Restar cantidad de ${product.name}`}
        >–</button>
        <span class="qty-value min-w-[1.25rem] text-center text-sm font-bold text-ink-950" aria-live="polite">1</span>
        <button
          type="button"
          class="qty-increment flex h-8 w-8 items-center justify-center text-base font-bold text-ink-950 cursor-pointer"
          aria-label={`Sumar cantidad de ${product.name}`}
        >+</button>
      </div>
    </div>

    <button
      type="button"
      data-add-to-cart={cardPayload}
      class="add-to-cart-btn btn btn-dark w-full mt-1"
      aria-label={`Agregar ${product.name} al carrito`}
    >
      Agregar
    </button>
  </div>
</article>
