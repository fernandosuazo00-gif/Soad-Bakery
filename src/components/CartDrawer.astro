---
import { contact, orderMethods } from "../data/site";
---

<div id="cart-drawer-root" class="fixed inset-0 z-[70] hidden" role="dialog" aria-modal="true" aria-label="Tu carrito">
  <div id="cart-backdrop" class="absolute inset-0 bg-ink-950/70"></div>

  <div class="absolute inset-y-0 right-0 flex w-full max-w-md flex-col bg-cream-50 shadow-2xl">
    <div class="flex items-center justify-between border-b border-ink-950/10 px-5 py-4">
      <h2 class="font-display text-xl font-semibold text-ink-950">Tu pedido</h2>
      <button
        type="button"
        id="cart-close"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full hover:bg-ink-950/5 cursor-pointer"
        aria-label="Cerrar carrito"
      >
        <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <div id="cart-items" class="flex-1 overflow-y-auto px-5 py-4 flex flex-col gap-4">
      <!-- populated by client script -->
    </div>

    <div id="cart-empty" class="flex-1 hidden flex-col items-center justify-center gap-3 px-8 text-center">
      <span class="text-4xl" aria-hidden="true">🧁</span>
      <p class="font-display text-lg font-semibold text-ink-950">Tu carrito está vacío</p>
      <p class="text-sm text-stone-600">Agregá tus favoritos desde el catálogo y armá tu pedido.</p>
      <a href="/productos" id="cart-empty-cta" class="btn btn-dark mt-2">Ver productos</a>
    </div>

    <div id="cart-footer" class="border-t border-ink-950/10 px-5 py-4 flex flex-col gap-4">
      <div class="flex items-center justify-between text-sm font-semibold text-ink-950">
        <span>Subtotal</span>
        <span id="cart-subtotal" class="tabular-nums">L 0</span>
      </div>
      <p id="cart-price-note" class="hidden -mt-2 text-xs text-stone-600">
        Algunos precios están pendientes de confirmar — te enviamos el total exacto por WhatsApp.
      </p>

      <fieldset>
        <legend class="text-xs font-bold uppercase tracking-wide text-stone-600 mb-2">Método de entrega</legend>
        <div class="grid grid-cols-2 gap-2">
          {
            Object.values(orderMethods).map((method) => (
              <label class="order-method-option cursor-pointer rounded-xl border-2 border-ink-950/10 px-3 py-2.5 text-center transition-colors">
                <input type="radio" name="order-method" value={method.id} class="sr-only" />
                <span class="block text-sm font-bold text-ink-950">{method.label}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="flex flex-col gap-2">
        <button type="button" id="cart-whatsapp-checkout" class="btn btn-primary w-full">
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
            <path d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.77.46 3.5 1.34 5.02L2 22l5.13-1.35A9.96 9.96 0 0 0 12.04 22c5.52 0 10-4.48 10-10s-4.48-10-10-10Zm0 18.2c-1.6 0-3.16-.43-4.53-1.24l-.32-.19-3.05.8.82-2.97-.21-.31A8.18 8.18 0 0 1 3.84 12c0-4.53 3.68-8.2 8.2-8.2 4.53 0 8.2 3.67 8.2 8.2 0 4.52-3.67 8.2-8.2 8.2Zm4.5-6.13c-.25-.12-1.47-.72-1.7-.81-.23-.08-.4-.12-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.04-.38-1.99-1.22-.73-.66-1.23-1.46-1.37-1.71-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.16-.25.25-.42.08-.17.04-.31-.02-.44-.06-.12-.56-1.36-.77-1.86-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08 0 1.22.89 2.41 1.02 2.58.12.17 1.75 2.68 4.25 3.75.59.26 1.06.41 1.42.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.14-1.18-.06-.1-.23-.16-.48-.28Z"></path>
          </svg>
          Pedir por WhatsApp
        </button>
        <p class="text-center text-xs text-stone-500">
          o también <a href={contact.pedidosYaUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-ink-950 underline underline-offset-2">pedí por PedidosYa</a>
        </p>
      </div>
    </div>
  </div>
</div>

<template id="cart-item-template">
  <div class="cart-item flex gap-3" data-id="">
    <img class="h-16 w-16 shrink-0 rounded-xl object-cover" src="" alt="" width="64" height="64" />
    <div class="flex flex-1 flex-col gap-1 min-w-0">
      <div class="flex items-start justify-between gap-2">
        <p class="item-name truncate text-sm font-semibold text-ink-950"></p>
        <button type="button" class="item-remove shrink-0 text-stone-500 hover:text-pink-600 cursor-pointer" aria-label="Quitar del carrito">
          <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
      <p class="item-price text-xs text-stone-500"></p>
      <div class="mt-1 inline-flex items-center gap-3 self-start rounded-full border border-ink-950/15 px-1">
        <button type="button" class="item-decrement flex h-8 w-8 items-center justify-center text-lg font-bold text-ink-950 cursor-pointer" aria-label="Restar cantidad">–</button>
        <span class="item-qty min-w-[1ch] text-sm font-bold text-ink-950" aria-live="polite"></span>
        <button type="button" class="item-increment flex h-8 w-8 items-center justify-center text-lg font-bold text-ink-950 cursor-pointer" aria-label="Sumar cantidad">+</button>
      </div>
    </div>
  </div>
</template>

<style>
  .order-method-option:has(input:checked) {
    border-color: var(--color-ink-950);
    background-color: var(--color-ink-950);
  }
  .order-method-option:has(input:checked) span {
    color: var(--color-cream-50);
  }
</style>

<script>
  import { SoadCart, type CartItem, type OrderMethod } from "../scripts/cart";
  import { buildWhatsAppUrl } from "../lib/whatsapp-message";
  import { formatLempiras } from "../lib/currency";
  import { contact } from "../data/site";

  const root = document.getElementById("cart-drawer-root")!;
  const backdrop = document.getElementById("cart-backdrop")!;
  const closeBtn = document.getElementById("cart-close")!;
  const itemsEl = document.getElementById("cart-items")!;
  const emptyEl = document.getElementById("cart-empty")!;
  const footerEl = document.getElementById("cart-footer")!;
  const subtotalEl = document.getElementById("cart-subtotal")!;
  const priceNoteEl = document.getElementById("cart-price-note")!;
  const template = document.getElementById("cart-item-template") as HTMLTemplateElement;
  const whatsappBtn = document.getElementById("cart-whatsapp-checkout")!;
  const methodInputs = Array.from(
    document.querySelectorAll<HTMLInputElement>('input[name="order-method"]')
  );

  const open = () => {
    root.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  };
  const close = () => {
    root.classList.add("hidden");
    document.body.style.overflow = "";
  };

  closeBtn.addEventListener("click", close);
  backdrop.addEventListener("click", close);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !root.classList.contains("hidden")) close();
  });
  window.addEventListener("soad-cart:open", open);

  const currentMethod = SoadCart.getMethod();
  methodInputs.forEach((input) => {
    input.checked = input.value === currentMethod;
    input.addEventListener("change", () => {
      if (input.checked) SoadCart.setMethod(input.value as OrderMethod);
    });
  });

  const render = (items: CartItem[]) => {
    itemsEl.innerHTML = "";
    const hasItems = items.length > 0;
    emptyEl.classList.toggle("hidden", hasItems);
    itemsEl.classList.toggle("hidden", !hasItems);
    footerEl.classList.toggle("hidden", !hasItems);

    let subtotal = 0;
    let hasUnpriced = false;

    for (const item of items) {
      const node = template.content.cloneNode(true) as DocumentFragment;
      const wrap = node.querySelector(".cart-item") as HTMLElement;
      wrap.dataset.id = item.id;
      (node.querySelector("img") as HTMLImageElement).src = item.image;
      (node.querySelector("img") as HTMLImageElement).alt = item.name;
      node.querySelector(".item-name")!.textContent = item.name;
      node.querySelector(".item-qty")!.textContent = String(item.qty);

      if (item.price === null) {
        node.querySelector(".item-price")!.textContent = "Precio próximamente";
        hasUnpriced = true;
      } else {
        node.querySelector(".item-price")!.textContent = `${formatLempiras(item.price)} c/u`;
        subtotal += item.price * item.qty;
      }

      itemsEl.appendChild(node);
    }

    subtotalEl.textContent = formatLempiras(subtotal) + (hasUnpriced ? " +" : "");
    priceNoteEl.classList.toggle("hidden", !hasUnpriced);
  };

  itemsEl.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const itemEl = target.closest<HTMLElement>(".cart-item");
    if (!itemEl) return;
    const id = itemEl.dataset.id!;
    const items = SoadCart.getItems();
    const current = items.find((i) => i.id === id);
    if (!current) return;

    if (target.closest(".item-increment")) {
      SoadCart.setQty(id, current.qty + 1);
    } else if (target.closest(".item-decrement")) {
      SoadCart.setQty(id, current.qty - 1);
    } else if (target.closest(".item-remove")) {
      SoadCart.remove(id);
    }
  });

  whatsappBtn.addEventListener("click", () => {
    const items = SoadCart.getItems();
    if (items.length === 0) return;
    const method = SoadCart.getMethod();
    const url = buildWhatsAppUrl(contact.whatsappBaseUrl, items, method);
    window.location.href = url;
  });

  window.addEventListener("soad-cart:change", (e) => {
    render((e as CustomEvent).detail.items);
  });

  render(SoadCart.getItems());
</script>
