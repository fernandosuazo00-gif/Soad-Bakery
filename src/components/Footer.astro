---
import { Image } from "astro:assets";
import logo from "../assets/logo/soad-logo.jpg";
import SocialIcons from "./SocialIcons.astro";
import { hours, contact, site } from "../data/site";
import { nav } from "../data/site";
---

<footer class="bg-ink-950 text-cream-100">
  <div class="container-page grid gap-10 py-14 md:grid-cols-4 md:py-16">
    <div class="md:col-span-1">
      <Image src={logo} alt="SOAD Bakery" width={96} height={96} class="h-14 w-14 rounded-full" />
      <p class="mt-4 font-display text-lg font-semibold text-cream-50">{site.name}</p>
      <p class="mt-1 text-sm text-cream-100/70">{site.city}</p>
      <p class="mt-3 text-sm text-cream-100/70">Delivery &amp; Pickup — sin tienda física, pedidos por WhatsApp, PedidosYa y nuestra vending machine.</p>
      <SocialIcons class="mt-5 text-cream-50" />
    </div>

    <div>
      <h3 class="text-xs font-bold uppercase tracking-wide text-cream-100/50">Horario</h3>
      <ul class="mt-4 flex flex-col gap-2 text-sm text-cream-100/80">
        {
          hours.map((h) => (
            <li class="flex flex-col">
              <span class="font-semibold text-cream-50">{h.days}</span>
              <span>{h.time}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="text-xs font-bold uppercase tracking-wide text-cream-100/50">Explorar</h3>
      <ul class="mt-4 flex flex-col gap-2.5 text-sm">
        {
          nav
            .filter((item) => item.href !== "/")
            .map((item) => (
              <li>
                <a href={item.href} class="text-cream-100/80 transition-colors hover:text-cream-50">
                  {item.label}
                </a>
              </li>
            ))
        }
      </ul>
    </div>

    <div>
      <h3 class="text-xs font-bold uppercase tracking-wide text-cream-100/50">Pedidos</h3>
      <ul class="mt-4 flex flex-col gap-2.5 text-sm">
        <li>
          <a
            href={`${contact.whatsappBaseUrl}?text=${encodeURIComponent("Hola SOAD Bakery 👋 quisiera hacer un pedido.")}`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-cream-100/80 transition-colors hover:text-cream-50"
          >
            WhatsApp — {contact.whatsappDisplay}
          </a>
        </li>
        <li>
          <a href={contact.pedidosYaUrl} target="_blank" rel="noopener noreferrer" class="text-cream-100/80 transition-colors hover:text-cream-50">
            PedidosYa
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-cream-50/10">
    <div class="container-page flex flex-col items-center gap-2 py-6 text-xs text-cream-100/50 sm:flex-row sm:justify-between">
      <p>© {new Date().getFullYear()} {site.name}. Todos los derechos reservados.</p>
      <p>Designed by FStudio</p>
    </div>
  </div>
</footer>
